# Trusted deployment configuration, not caller-controlled request fields.
IO_COMPANY_CD=
IO_ENVIRONMENT=DEVELOPMENT
# Explicit read-only PostgreSQL credentials; no default host or credentials.
IO_POSTGRES_DSN=

# Platform Lifecycle callback used by the Inventory Runtime Worker.
INVENTORY_PLATFORM_API_BASE_URL=
INVENTORY_PLATFORM_API_TIMEOUT_SECONDS=10
# Production requires a service-principal access token with engine_run.execute.
INVENTORY_PLATFORM_API_BEARER_TOKEN=
