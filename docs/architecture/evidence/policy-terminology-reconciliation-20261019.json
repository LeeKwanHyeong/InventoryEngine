  "development_definitions_not_legacy_rules": [
    "monthly demand = historical weekly mean * 52 / 12",
    "normal safety stock, sequential UOM ceiling and ROP floor",
    "requested EMOS covers base Q, never Q/2 by implicit reinterpretation",
    "effective EMOS = (final S - final ROP) / monthly demand",
