    "storage_version": "3.0.0",
    "layout": "SHARED_INPUTS_V1",
    "shared_fields": [
      "parent_classification",
      "calendar",
      "forecast",
      "future_demand"
    ],
    "minimum_value_bytes": 512,
    "maximum_references_per_document": 4096,
    "maximum_path_depth": 64,
    "maximum_raw_and_restored_document_bytes": 128000000,
    "maximum_experiment_raw_storage_bytes": 20000000000,
    "maximum_invocation_seconds": 3600,
    "global_resource_reservation_or_cancellation_implemented": false,
    "shared_value_dependencies": "FLAT_PLAIN_VALUES_NOT_RECURSIVE_REFERENCES",
    "compatibility": "NEW_READER_ACCEPTS_V1_V2_V3_EXISTING_FILES_AND_COMPLETE_RECEIPTS_UNCHANGED_OLD_READERS_DO_NOT_ACCEPT_V3",
    "hash_equivalence": "ORIGINAL_CANONICAL_JSON_UTF8_PLUS_LF_AND_CALCULATION_RESULT_HASH_UNCHANGED_PHYSICAL_MANIFEST_RECEIPT_MAY_DIFFER",
    "raw_budget": "SUM_UNIQUE_UNCOMPRESSED_PHYSICAL_WRAPPERS_LAYOUTS_OBJECTS_SLOTS_AND_REPORT_METADATA_NOT_A_COMPRESSION_DISCOUNT",
    "expanded_logical_bytes_reported_separately": true
  },
  "implemented": [
    "Optional Repository with shared immutable parent classification/Calendar/Forecast values, no change to default Writer/Runtime",
    "Exact canonical logical document reconstruction before original hash and actual Catalog/Guard/PSI replay",
    "Separate closed path table and null placeholders; data resembling references is not interpreted",
    "Input dependencies published before document/checkpoint and COMPLETE; idempotent content-addressed sharing across documents",
    "Bounded fan-out size prediction before loading dependencies, path/count/depth checks and independent mutable values per restored position",
    "Physical SHA/length, gzip frame/CRC, raw wrapper SHA/length and shared value SHA/length validation; no fallback after corruption",
    "V1/V2 unchanged complete-run reads and partial checkpoint recovery with mixed V1/V2/V3 references",
    "Original all-failed candidate denominators, REVIEW and FSN BLOCK publication/order restrictions retained",
    "Actual process exit after first V3 leaf checkpoint and retry after an orphan shared file publication verified"
  ],
  "not_implemented_or_performed": [
    "Repeated preparation/serialization reuse, summary-read/replay separation, whole-result streaming or Parquet conversion",
    "Speedup/memory verdict, new three-repetition timing benchmark, peak scratch-disk measurement or 20GB global quota enforcement",
    "Official path generation, complete Split bank orchestration or the main robustness experiment",
    "DB access/writes/migrations, Platform change, installation, public Runtime deployment, actual order or model promotion",
    "FSN setting or operational Gate changes, commit, push, branch change or personal report modification"
  ],
