  "implemented": [
    "Explicit opt-in Gzip level-1 storage V2; existing V1 Writer and default Runtime unchanged",
    "Closed physical reference with logical content hash, raw byte hash/length, stored byte hash/length and pinned codec/version",
    "V1 unchanged reads and V1/V2 mixed recovery; no overwrite, deletion or implicit corruption fallback",
    "Bounded decompression before JSON parsing with physical hash, raw hash, frame CRC, truncation and trailing/member checks",
    "Append-only publication and same-hash idempotence reuse existing valid physical gzip bytes without recompressing",
    "Original Catalog, Guard, causal PSI, cost scorecards and actual replay verification preserved",
    "Frozen 18-case fresh-process serial comparison, source pinning and raw budget accounting independent of compression"
  ],
  "not_implemented_or_performed": [
    "Shared-input reference normalization, repeated preparation/serialization reuse or fast-read/replay separation",
    "Whole-result streaming, Parquet conversion, per-phase allocation profiling or transient scratch-disk peak measurement",
    "Global production raw-budget reservation, deadline cancellation, crash-temporary retention or cleanup",
    "Official 2037/2044 path generation, full Split Bank orchestration or the main robustness comparison",
    "V100/P12 admission resolution, actual Source authority approval, ML/PPO training or model promotion",
    "DB access/writes, migrations, Platform changes, installation or shared Runtime deployment",
    "FSN or operational Gate changes, actual orders, commit, push or branch changes"
  ],
