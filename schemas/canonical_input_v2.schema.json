  "$defs": {
    "calendar_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yyyyww",
        "seq",
        "start_date",
        "end_date",
        "base_month"
      ],
      "properties": {
        "yyyyww": {
          "type": "string",
          "pattern": "^[1-9][0-9]{3}(0[1-9]|[1-4][0-9]|5[0-3])$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "base_month": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      }
    },
