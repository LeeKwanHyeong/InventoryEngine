              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "content_hash"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "customer_orders": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "content_hash"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "content_hash"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "prior_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "content_hash"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "receipts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "content_hash"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshot_id",
            "content_hash"
          ],
          "properties": {
            "snapshot_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
