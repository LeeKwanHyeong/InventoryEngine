{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical IO input v2 — fractional planning, physical quantities remain constrained",
  "description": "V2 only: planning_scale and physical_scale. 200000 rows per snapshot, 128MB encoded request. V1 remains separate. Admission verifies hashes, scope, physical EA, cutoff and grid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "context",
    "quantity_rules",
    "input_bindings",
    "snapshots"
  ],
  "properties": {
    "contract_id": {
      "const": "io-canonical-input-v2"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_cd",
        "subs_cd",
        "site_cd",
        "engine_run_id",
        "planning_cycle_id",
        "planning_cycle_revision_id",
        "cycle_site_execution_id",
        "plan_id",
        "plan_type",
        "plan_yyyyww",
        "plan_start_date",
        "plan_end_date",
        "master_as_of_date",
        "master_snapshot_revision",
        "demand_run_id",
        "configuration_revision",
        "business_timezone",
        "inventory_cutoff_at",
        "inventory_source_watermark"
      ],
      "properties": {
        "company_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "subs_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "site_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "engine_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "planning_cycle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "planning_cycle_revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "cycle_site_execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "plan_type": {
          "type": "string",
          "enum": [
            "POSM",
            "TGSM"
          ]
        },
        "plan_yyyyww": {
          "type": "string",
          "pattern": "^[1-9][0-9]{3}(0[1-9]|[1-4][0-9]|5[0-3])$"
        },
        "plan_start_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "plan_end_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "master_as_of_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "master_snapshot_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "demand_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "configuration_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "business_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "inventory_cutoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "inventory_source_watermark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "quantity_rules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uom",
          "tolerance_qty",
          "approval_reference",
          "planning_scale",
          "physical_scale"
        ],
        "properties": {
          "uom": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "tolerance_qty": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
            "maxLength": 40
          },
          "approval_reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "planning_scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "physical_scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "master",
        "forecast",
        "customer_orders",
        "inventory",
        "prior_inventory",
        "receipts",
