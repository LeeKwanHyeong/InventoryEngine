        }
      }
    },
    "calendar_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "content_hash",
        "status",
        "row_count",
        "metadata",
        "rows"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "COLLECTING",
            "CUT_OFF_REACHED",
            "RECONCILING",
            "SEALED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "metadata": {
          "$ref": "#/$defs/calendar_metadata"
        },
        "rows": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/calendar_row"
          }
        }
      }
    },
