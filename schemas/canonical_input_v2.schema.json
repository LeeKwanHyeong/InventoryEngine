          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "effective_from": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effective_to": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "moq": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
          "maxLength": 40
        },
        "order_multiple": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
          "maxLength": 40
        },
        "physical_max_capacity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_service_level": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
          "maxLength": 40
        },
        "source_target_inventory_qty": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "source_rop_qty": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_source_type": {
          "type": "string",
          "enum": [
            "SOURCE_MASTER",
            "SYNTHETIC_POLICY"
          ]
        },
        "source_semantics_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      }
    },
    "policies_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_cd",
        "subs_cd",
        "site_cd"
      ],
      "properties": {
        "company_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "subs_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "site_cd": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      }
    },
    "policies_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "content_hash",
        "status",
        "row_count",
        "metadata",
        "rows"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "COLLECTING",
            "CUT_OFF_REACHED",
            "RECONCILING",
            "SEALED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "metadata": {
          "$ref": "#/$defs/policies_metadata"
        },
        "rows": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/policies_row"
          }
        }
      }
    }
  }
}
