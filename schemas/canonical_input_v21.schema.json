{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical IO input 2.1 — explicit development calculation universe",
  "description": "Development-only cohort. Raw shared Master and Forecast are not altered; production admission is forbidden. Hashes are verified in Python, not authenticated by schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "contract_version", "context", "quantity_rules", "input_bindings", "snapshots", "development_universe", "upstream_bindings"],
  "properties": {
    "contract_id": {"const": "io-canonical-input-v2"},
    "contract_version": {"const": "2.1.0"},
    "context": {"$ref": "canonical_input_v2.schema.json#/properties/context"},
    "quantity_rules": {"$ref": "canonical_input_v2.schema.json#/properties/quantity_rules"},
    "input_bindings": {"$ref": "canonical_input_v2.schema.json#/properties/input_bindings"},
    "snapshots": {"$ref": "canonical_input_v2.schema.json#/properties/snapshots"},
    "upstream_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["calendar", "master", "forecast"],
      "properties": {"calendar": {"$ref": "#/$defs/reference"}, "master": {"$ref": "#/$defs/reference"}, "forecast": {"$ref": "#/$defs/reference"}}
    },
    "development_universe": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "environment_scope", "demand_run_id", "plan_yyyyww", "original_master_content_hash", "original_forecast_content_hash", "source_demand_window_file_sha256", "approval_reference", "included_item_ids", "exclusions", "content_hash"],
      "properties": {
        "contract_id": {"enum": ["io-development-calculation-universe-v1", "io-development-calculation-universe-v2", "io-development-calculation-universe-v3"]},
        "classification_snapshot_id": {"$ref": "#/$defs/id"},
        "classification_content_hash": {"$ref": "#/$defs/hash"},
        "environment_scope": {"const": "DEVELOPMENT"},
        "demand_run_id": {"$ref": "#/$defs/id"},
        "plan_yyyyww": {"type": "string", "pattern": "^[1-9][0-9]{3}(0[1-9]|[1-4][0-9]|5[0-3])$"},
        "original_master_content_hash": {"$ref": "#/$defs/hash"},
        "original_forecast_content_hash": {"$ref": "#/$defs/hash"},
        "source_demand_window_file_sha256": {"$ref": "#/$defs/hash"},
        "approval_reference": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "included_item_ids": {"type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "exclusions": {"type": "array", "maxItems": 20000, "items": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["item_id", "reason", "demand_end_yyyyww"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "reason": {"const": "EXCLUDED_ENDED_DEMAND_WINDOW"}, "demand_end_yyyyww": {"type": "string", "pattern": "^[1-9][0-9]{3}(0[1-9]|[1-4][0-9]|5[0-3])$"}}},
          {"type": "object", "additionalProperties": false, "required": ["item_id", "reason", "policy_gate_reason_codes"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "reason": {"const": "EXCLUDED_POLICY_CALCULATION_BLOCKED"}, "policy_gate_reason_codes": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
          {"type": "object", "additionalProperties": false, "required": ["item_id", "reason"], "properties": {"item_id": {"$ref": "#/$defs/id"}, "reason": {"const": "EXCLUDED_DEVELOPMENT_SAMPLE"}}}
        ]}}
      },
      "allOf": [{"if": {"properties": {"contract_id": {"enum": ["io-development-calculation-universe-v2", "io-development-calculation-universe-v3"]}}},
        "then": {"required": ["classification_snapshot_id", "classification_content_hash"]},
        "else": {"properties": {"classification_snapshot_id": false, "classification_content_hash": false, "exclusions": {"items": {"properties": {"reason": {"const": "EXCLUDED_ENDED_DEMAND_WINDOW"}}}}}}
      }, {"if": {"properties": {"contract_id": {"enum": ["io-development-calculation-universe-v1", "io-development-calculation-universe-v2"]}}},
        "then": {"properties": {"exclusions": {"items": {"properties": {"reason": {"enum": ["EXCLUDED_ENDED_DEMAND_WINDOW", "EXCLUDED_POLICY_CALCULATION_BLOCKED"]}}}}}}
      }]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "content_hash"], "properties": {"snapshot_id": {"$ref": "#/$defs/id"}, "content_hash": {"$ref": "#/$defs/hash"}}}
  }
}
