{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsai:inventory-policy-analysis-spec:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "execution_mode",
    "config_schema_version",
    "config_id",
    "config_revision_id",
    "config_hash",
    "classification_snapshot_id",
    "classification_snapshot_content_hash",
    "effective_policy_content_hash",
    "search_spec",
    "search_spec_content_hash",
    "evaluation_spec",
    "content_hash"
  ],
  "properties": {
    "contract_id": {
      "const": "inventory-policy-analysis-spec"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "execution_mode": {
      "const": "DEVELOPMENT_SHADOW"
    },
    "config_schema_version": {
      "const": "2.1.0"
    },
    "config_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "config_revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "classification_snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "classification_snapshot_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effective_policy_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "search_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "enabled",
        "evaluation_mode",
        "month_basis",
        "lookback_weeks",
        "max_candidates_per_item",
        "minimum_fill_rate",
        "selection_rule",
        "group_profiles",
        "item_overrides",
        "cost_assumptions"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "enabled": {
          "type": "boolean"
        },
        "evaluation_mode": {
          "const": "DEVELOPMENT_SHADOW"
        },
        "month_basis": {
          "const": "52_WEEKS_PER_YEAR"
        },
        "lookback_weeks": {
          "enum": [
            13,
            26
          ]
        },
        "max_candidates_per_item": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "minimum_fill_rate": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$"
        },
        "selection_rule": {
          "const": "SERVICE_FEASIBLE_THEN_LOWEST_COST"
        },
        "group_profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_kinds",
              "rmos_values",
              "emos_values",
              "service_level_values",
              "review_cycle_weeks",
              "segment_key"
            ],
            "properties": {
              "policy_kinds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "ROP_FIXED_Q",
                    "PERIODIC_ORDER_UP_TO"
                  ]
                }
              },
              "rmos_values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                }
              },
              "emos_values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                }
              },
              "service_level_values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                }
              },
              "review_cycle_weeks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 13,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 13
                }
              },
              "segment_key": {
                "enum": [
                  "AX",
                  "AY",
                  "AZ",
                  "BX",
                  "BY",
                  "BZ",
                  "CX",
                  "CY",
                  "CZ"
                ]
              }
            }
          }
        },
        "item_overrides": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_kinds",
              "rmos_values",
              "emos_values",
              "service_level_values",
              "review_cycle_weeks",
              "item_id",
              "reason"
            ],
            "properties": {
              "policy_kinds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "ROP_FIXED_Q",
                    "PERIODIC_ORDER_UP_TO"
                  ]
                }
              },
              "rmos_values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                }
              },
              "emos_values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                }
              },
              "service_level_values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                }
              },
              "review_cycle_weeks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 13,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 13
                }
              },
              "item_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        },
        "cost_assumptions": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "currency",
            "holding_cost_per_unit_week",
            "backorder_cost_per_unit_week",
            "fixed_order_cost",
            "variable_order_cost_per_unit",
            "source_type",
            "allocation_basis"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "source_type": {
              "const": "DEVELOPMENT_ASSUMPTION"
            },
            "allocation_basis": {
              "const": "PER_ITEM_ORDER"
            },
            "holding_cost_per_unit_week": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
            },
            "backorder_cost_per_unit_week": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
            },
            "fixed_order_cost": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
            },
            "variable_order_cost_per_unit": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
            }
          }
        }
      }
    },
    "search_spec_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_spec": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "DISABLED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "evaluation_id",
            "source_type",
            "reference_case_id",
            "reference_cost_profile_id",
            "cases",
            "cost_profiles",
            "terminal_pairs"
          ],
          "properties": {
            "mode": {
              "const": "SEALED_SYNTHETIC_CASES"
            },
            "evaluation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "source_type": {
              "const": "SYNTHETIC_PLANNING_INPUT"
            },
            "reference_case_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "reference_cost_profile_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "cases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "trace_id",
                  "split",
                  "seed",
                  "input_source",
                  "input_snapshot_id",
                  "input_content_hash"
                ],
                "properties": {
                  "case_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "trace_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "split": {
                    "enum": [
                      "VALIDATION",
                      "HOLDOUT"
                    ]
                  },
                  "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "input_source": {
                    "enum": [
                      "CURRENT_RUN",
                      "SEALED_MATHEMATICAL_REQUEST"
                    ]
                  },
                  "input_snapshot_id": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                      }
                    ]
                  },
                  "input_content_hash": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "input_source": {
                          "const": "CURRENT_RUN"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "input_snapshot_id": {
                          "type": "null"
                        },
                        "input_content_hash": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "input_snapshot_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                        },
                        "input_content_hash": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "cost_profiles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile_id",
                  "cost_assumptions"
                ],
                "properties": {
                  "profile_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "cost_assumptions": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "currency",
                      "holding_cost_per_unit_week",
                      "backorder_cost_per_unit_week",
                      "fixed_order_cost",
                      "variable_order_cost_per_unit",
                      "source_type",
                      "allocation_basis"
                    ],
                    "properties": {
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "source_type": {
                        "const": "DEVELOPMENT_ASSUMPTION"
                      },
                      "allocation_basis": {
                        "const": "PER_ITEM_ORDER"
                      },
                      "holding_cost_per_unit_week": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                      },
                      "backorder_cost_per_unit_week": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                      },
                      "fixed_order_cost": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                      },
                      "variable_order_cost_per_unit": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
                      }
                    }
                  }
                }
              }
            },
            "terminal_pairs": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "short_case_id",
                  "extended_case_id"
                ],
                "properties": {
                  "short_case_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "extended_case_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "search_spec": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluation_spec": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "DISABLED"
              }
            }
          }
        }
      }
    }
  ]
}
