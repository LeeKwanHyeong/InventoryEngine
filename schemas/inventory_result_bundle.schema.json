{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsio.local/schemas/inventory_result_bundle.schema.json",
  "title": "Inventory strategy execution plan or PSI result bundle",
  "oneOf": [
    { "$ref": "#/$defs/strategyExecutionPlan" },
    { "$ref": "#/$defs/resultBundle" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "opaqueId": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        { "pattern": "^\\S(?:.*\\S)?$" },
        { "pattern": "^[^\\u0000-\\u001F\\u007F]+$" }
      ]
    },
    "signedDecimal": {
      "type": "string",
      "maxLength": 29,
      "pattern": "^-?(?:(?:0|[1-9][0-9]{0,19}|1[0-9]{20})(?:\\.[0-9]{1,6})?|200000000000000000000(?:\\.0{1,6})?)$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "version", "content_hash"],
      "properties": {
        "model_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "mathematicalStrategyInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "snapshot_id", "content_hash"],
      "properties": {
        "contract_id": { "const": "io-mathematical-policy-input-v1" },
        "contract_version": { "const": "1.0.0" },
        "snapshot_id": { "$ref": "#/$defs/id" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "operationalStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_type",
        "implementation_id",
        "version",
        "implementation_content_hash",
        "replenishment_config_content_hash",
        "strategy_input_binding"
      ],
      "properties": {
        "strategy_type": { "const": "MATHEMATICAL" },
        "implementation_id": { "const": "historical-normal-r-s" },
        "version": { "const": "1.0.0" },
        "implementation_content_hash": { "$ref": "#/$defs/hash" },
        "replenishment_config_content_hash": { "$ref": "#/$defs/hash" },
        "strategy_input_binding": {
          "$ref": "#/$defs/mathematicalStrategyInputBinding"
        }
      }
    },
    "psiSimulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_id", "version", "implementation_content_hash"],
      "properties": {
        "implementation_id": { "const": "inventory.psi.weekly_roll_forward" },
        "version": { "const": "1.0.0" },
        "implementation_content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "shadowChallenger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenger_id",
        "strategy_type",
        "algorithm",
        "implementation_id",
        "version",
        "implementation_content_hash",
        "model",
        "approval_reference"
      ],
      "properties": {
        "challenger_id": { "$ref": "#/$defs/id" },
        "strategy_type": { "const": "DEEP_RL" },
        "algorithm": { "const": "PPO" },
        "implementation_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "implementation_content_hash": { "$ref": "#/$defs/hash" },
        "model": { "$ref": "#/$defs/model" },
        "approval_reference": { "$ref": "#/$defs/id" }
      }
    },
    "stressScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_type",
        "scenario_contract_key",
        "scenario_contract_version",
        "scenario_payload_content_hash",
        "deterministic_seed",
        "scenario_content_hash",
        "runner_implementation_id",
        "runner_implementation_version",
        "runner_implementation_content_hash"
      ],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/id" },
        "scenario_type": { "const": "STRESS" },
        "scenario_contract_key": { "$ref": "#/$defs/id" },
        "scenario_contract_version": { "$ref": "#/$defs/version" },
        "scenario_payload_content_hash": { "$ref": "#/$defs/hash" },
        "deterministic_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "scenario_content_hash": { "$ref": "#/$defs/hash" },
        "runner_implementation_id": { "$ref": "#/$defs/id" },
        "runner_implementation_version": { "$ref": "#/$defs/id" },
        "runner_implementation_content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "costProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_profile_id",
        "profile_contract_key",
        "profile_contract_version",
        "profile_payload_content_hash",
        "profile_content_hash",
        "source_type",
        "approval_reference"
      ],
      "properties": {
        "cost_profile_id": { "$ref": "#/$defs/id" },
        "profile_contract_key": { "const": "inventory.cost_profile" },
        "profile_contract_version": { "$ref": "#/$defs/version" },
        "profile_payload_content_hash": { "$ref": "#/$defs/hash" },
        "profile_content_hash": { "$ref": "#/$defs/hash" },
        "source_type": { "enum": ["DEVELOPMENT_SYNTHETIC", "AUTHORIZED_SOURCE"] },
        "approval_reference": { "$ref": "#/$defs/id" }
      }
    },
    "strategyExecutionPlan": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"contract_version": {"const": "1.2.0"}}},
        "then": {"required": ["landed_cost_binding"], "properties": {"cost_profile_binding": {"$ref": "#/$defs/costProfile"}}},
        "else": {"not": {"required": ["landed_cost_binding"]}}
      }],
      "required": [
        "contract_id",
        "contract_version",
        "strategy_execution_plan_id",
        "classification_config_hash",
        "effective_policy_content_hash",
        "base_scenario_contract_key",
        "base_scenario_contract_version",
        "base_scenario_content_hash",
        "psi_simulator",
        "operational_strategy",
        "shadow_challenger_bindings",
        "stress_scenario_bindings",
        "cost_profile_binding",
        "result_bundle_contract_key",
        "result_bundle_contract_version",
        "content_hash"
      ],
      "properties": {
        "contract_id": { "const": "inventory-strategy-execution-plan-v1" },
        "contract_version": { "enum": ["1.1.0", "1.2.0"] },
        "landed_cost_binding": {"type":"object","additionalProperties":false,"required":["input_contract_key","input_contract_version","input_snapshot_id","input_content_hash","cost_application_mode","origin_site_cd","destination_site_cd","network_revision_id","revision_set_id","revision_set_content_hash","valuation_date","judgment_at"],"properties":{"input_contract_key":{"const":"inventory.landed_cost.run_input"},"input_contract_version":{"const":"1.0.0"},"input_snapshot_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},"input_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"cost_application_mode":{"const":"DEVELOPMENT_LANE_PRICING_PROXY"},"origin_site_cd":{"const":"V100"},"destination_site_cd":{"enum":["V101","V102","V103","V104"]},"network_revision_id":{"type":"string","format":"uuid"},"revision_set_id":{"type":"string","format":"uuid"},"revision_set_content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"valuation_date":{"type":"string","format":"date"},"judgment_at":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"}}},
        "strategy_execution_plan_id": { "$ref": "#/$defs/id" },
        "classification_config_hash": { "$ref": "#/$defs/hash" },
        "effective_policy_content_hash": { "$ref": "#/$defs/hash" },
        "base_scenario_contract_key": { "const": "inventory.scenario.base" },
        "base_scenario_contract_version": { "const": "1.0.0" },
        "base_scenario_content_hash": {
          "const": "e385b25e899b156c69004e069ee46dbefe1d5dc29930149dd7903f2b2197f472"
        },
        "psi_simulator": { "$ref": "#/$defs/psiSimulator" },
        "operational_strategy": { "$ref": "#/$defs/operationalStrategy" },
        "shadow_challenger_bindings": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/shadowChallenger" }
        },
        "stress_scenario_bindings": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/stressScenario" }
        },
        "cost_profile_binding": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/costProfile" }
          ]
        },
        "result_bundle_contract_key": { "const": "inventory.result_bundle" },
        "result_bundle_contract_version": { "const": "1.0.0" },
        "content_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "actionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_action_reference",
        "raw_action_content_hash",
        "constrained_action_reference",
        "constrained_action_content_hash",
        "adjustment_reasons_reference",
        "adjustment_reasons_content_hash"
      ],
      "properties": {
        "raw_action_reference": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }]
        },
        "raw_action_content_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
        },
        "constrained_action_reference": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }]
        },
        "constrained_action_content_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
        },
        "adjustment_reasons_reference": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }]
        },
        "adjustment_reasons_content_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
        }
      },
      "oneOf": [
        {
          "properties": {
            "raw_action_reference": { "type": "null" },
            "raw_action_content_hash": { "type": "null" },
            "constrained_action_reference": { "type": "null" },
            "constrained_action_content_hash": { "type": "null" },
            "adjustment_reasons_reference": { "type": "null" },
            "adjustment_reasons_content_hash": { "type": "null" }
          }
        },
        {
          "properties": {
            "raw_action_reference": { "$ref": "#/$defs/reference" },
            "raw_action_content_hash": { "$ref": "#/$defs/hash" },
            "constrained_action_reference": { "$ref": "#/$defs/reference" },
            "constrained_action_content_hash": { "$ref": "#/$defs/hash" },
            "adjustment_reasons_reference": { "$ref": "#/$defs/reference" },
            "adjustment_reasons_content_hash": { "$ref": "#/$defs/hash" }
          }
        }
      ]
    },
    "childResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_result_id",
        "result_kind",
        "execution_role",
        "strategy_type",
        "scenario_id",
        "scenario_content_hash",
        "challenger_id",
        "model_content_hash",
        "status",
        "artifact_reference",
        "artifact_contract_key",
        "artifact_contract_version",
        "child_content_hash",
        "row_count",
        "failure_reason_code",
        "action_evidence"
      ],
      "properties": {
        "child_result_id": { "$ref": "#/$defs/id" },
        "result_kind": {
          "enum": ["BASELINE_PSI", "RECOMMENDED_PSI", "STRESS_PSI"]
        },
        "execution_role": {
          "enum": ["OPERATIONAL", "SHADOW", "EVIDENCE_ONLY"]
        },
        "strategy_type": {
          "enum": ["NONE", "MATHEMATICAL", "DEEP_RL"]
        },
        "scenario_id": { "$ref": "#/$defs/id" },
        "scenario_content_hash": { "$ref": "#/$defs/hash" },
        "challenger_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "model_content_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
        },
        "status": { "enum": ["SUCCEEDED", "FAILED", "SKIPPED"] },
        "artifact_reference": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reference" }]
        },
        "artifact_contract_key": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "artifact_contract_version": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/version" }]
        },
        "child_content_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
        },
        "row_count": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 100000000 }]
        },
        "failure_reason_code": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "action_evidence": { "$ref": "#/$defs/actionEvidence" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "SUCCEEDED" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "artifact_reference": { "$ref": "#/$defs/reference" },
              "artifact_contract_key": { "const": "inventory.psi_result" },
              "artifact_contract_version": { "const": "1.0.0" },
              "child_content_hash": { "$ref": "#/$defs/hash" },
              "row_count": { "type": "integer", "minimum": 1, "maximum": 100000000 },
              "failure_reason_code": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "artifact_reference": { "type": "null" },
              "artifact_contract_key": { "type": "null" },
              "artifact_contract_version": { "type": "null" },
              "child_content_hash": { "type": "null" },
              "row_count": { "type": "null" },
              "failure_reason_code": { "$ref": "#/$defs/id" },
              "action_evidence": {
                "properties": { "raw_action_reference": { "type": "null" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "strategy_type": { "const": "DEEP_RL" } },
            "required": ["strategy_type"]
          },
          "then": {
            "properties": {
              "challenger_id": { "$ref": "#/$defs/id" },
              "model_content_hash": { "$ref": "#/$defs/hash" }
            }
          },
          "else": {
            "properties": {
              "challenger_id": { "type": "null" },
              "model_content_hash": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "SUCCEEDED" },
              "strategy_type": { "not": { "const": "NONE" } }
            },
            "required": ["status", "strategy_type"]
          },
          "then": {
            "properties": {
              "action_evidence": {
                "properties": {
                  "raw_action_reference": { "$ref": "#/$defs/reference" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "strategy_type": { "const": "NONE" } },
            "required": ["strategy_type"]
          },
          "then": {
            "properties": {
              "action_evidence": {
                "properties": { "raw_action_reference": { "type": "null" } }
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "result_kind": { "const": "BASELINE_PSI" },
                "execution_role": { "const": "EVIDENCE_ONLY" },
                "strategy_type": { "const": "NONE" },
                "scenario_id": { "const": "BASE" },
                "status": { "const": "SUCCEEDED" }
              }
            },
            {
              "properties": {
                "result_kind": { "const": "RECOMMENDED_PSI" },
                "execution_role": { "const": "OPERATIONAL" },
                "strategy_type": { "const": "MATHEMATICAL" },
                "scenario_id": { "const": "BASE" },
                "status": { "const": "SUCCEEDED" }
              }
            },
            {
              "properties": {
                "result_kind": { "const": "RECOMMENDED_PSI" },
                "execution_role": { "const": "SHADOW" },
                "strategy_type": { "const": "DEEP_RL" },
                "scenario_id": { "const": "BASE" },
                "status": { "enum": ["SUCCEEDED", "FAILED"] }
              }
            },
            {
              "properties": {
                "result_kind": { "const": "STRESS_PSI" },
                "execution_role": { "const": "EVIDENCE_ONLY" },
                "strategy_type": { "const": "MATHEMATICAL" },
                "scenario_id": { "not": { "const": "BASE" } }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "status": { "const": "SKIPPED" } },
                    "required": ["status"]
                  },
                  "then": {
                    "properties": {
                      "failure_reason_code": { "const": "STRESS_SCENARIO_UNAVAILABLE" }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "status": { "const": "FAILED" } },
                    "required": ["status"]
                  },
                  "then": {
                    "properties": {
                      "failure_reason_code": {
                        "not": { "const": "STRESS_SCENARIO_UNAVAILABLE" }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "metricDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reason_code"],
      "properties": {
        "status": { "enum": ["AVAILABLE", "NOT_AVAILABLE"] },
        "value": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/signedDecimal" }]
        },
        "reason_code": {
          "oneOf": [
            { "type": "null" },
            {
              "enum": [
                "COST_PROFILE_NOT_BOUND",
                "CANDIDATE_RESULT_FAILED",
                "CANDIDATE_RESULT_SKIPPED",
                "NO_DEMAND_IN_HORIZON"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "AVAILABLE" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "value": { "$ref": "#/$defs/signedDecimal" },
              "reason_code": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "value": { "type": "null" },
              "reason_code": {
                "enum": [
                  "COST_PROFILE_NOT_BOUND",
                  "CANDIDATE_RESULT_FAILED",
                  "CANDIDATE_RESULT_SKIPPED",
                  "NO_DEMAND_IN_HORIZON"
                ]
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_child_result_id",
        "candidate_child_result_id",
        "cost_delta",
        "service_level_delta",
        "backorder_qty_delta"
      ],
      "properties": {
        "baseline_child_result_id": { "$ref": "#/$defs/id" },
        "candidate_child_result_id": { "$ref": "#/$defs/id" },
        "cost_delta": { "$ref": "#/$defs/metricDelta" },
        "service_level_delta": { "$ref": "#/$defs/metricDelta" },
        "backorder_qty_delta": { "$ref": "#/$defs/metricDelta" }
      }
    },
    "resultBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "source_contract_key",
        "result_bundle_id",
        "engine_run_id",
        "attempt_no",
        "tenant_id",
        "project_id",
        "planning_cycle_id",
        "planning_cycle_revision_id",
        "cycle_site_execution_id",
        "plan_id",
        "scope",
        "canonical_input_hash",
        "site_binding_hash",
        "strategy_execution_plan_id",
        "strategy_execution_plan_content_hash",
        "classification_config_hash",
        "effective_policy_content_hash",
        "cost_profile_content_hash",
        "result_children",
        "effective_child_result_id",
        "comparisons",
        "automatic_publish_allowed",
        "automatic_order_allowed",
        "content_hash"
      ],
      "properties": {
        "contract_id": { "const": "inventory-result-bundle-v1" },
        "contract_version": { "const": "1.0.0" },
        "source_contract_key": { "const": "inventory.result_bundle" },
        "result_bundle_id": {
          "type": "string",
          "pattern": "^IOB-[0-9a-f]{64}$"
        },
        "engine_run_id": { "$ref": "#/$defs/id" },
        "attempt_no": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "tenant_id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "planning_cycle_id": { "$ref": "#/$defs/id" },
        "planning_cycle_revision_id": { "$ref": "#/$defs/id" },
        "cycle_site_execution_id": { "$ref": "#/$defs/id" },
        "plan_id": { "$ref": "#/$defs/opaqueId" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["company_cd", "subs_cd", "plant_cd", "site_cd"],
          "properties": {
            "company_cd": { "$ref": "#/$defs/id" },
            "subs_cd": { "$ref": "#/$defs/id" },
            "plant_cd": { "$ref": "#/$defs/id" },
            "site_cd": { "$ref": "#/$defs/id" }
          }
        },
        "canonical_input_hash": { "$ref": "#/$defs/hash" },
        "site_binding_hash": { "$ref": "#/$defs/hash" },
        "strategy_execution_plan_id": { "$ref": "#/$defs/id" },
        "strategy_execution_plan_content_hash": { "$ref": "#/$defs/hash" },
        "classification_config_hash": { "$ref": "#/$defs/hash" },
        "effective_policy_content_hash": { "$ref": "#/$defs/hash" },
        "cost_profile_content_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
        },
        "result_children": {
          "type": "array",
          "minItems": 2,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/childResult" }
        },
        "effective_child_result_id": { "$ref": "#/$defs/id" },
        "comparisons": {
          "type": "array",
          "maxItems": 511,
          "items": { "$ref": "#/$defs/comparison" }
        },
        "automatic_publish_allowed": { "type": "boolean" },
