{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dsio.local/inventory_run_result_manifest.schema.json",
  "title": "Evidence-only Run parent and Simulation cost comparisons",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "source_contract_key",
    "artifact_reference",
    "engine_run_id",
    "attempt_no",
    "tenant_id",
    "project_id",
    "runtime_request_content_hash",
    "canonical_input_hash",
    "site_binding_hash",
    "strategy_execution_plan_content_hash",
    "psi_result",
    "input_reference",
    "input_content_hash",
    "projection_reference",
    "projection_content_hash",
    "profile_reference",
    "profile_content_hash",
    "cost_application_mode",
    "recognition_rule",
    "cost_currency",
    "operational_cost_eligible",
    "cost_children",
    "simulation_metrics",
    "simulation_comparisons",
    "content_hash"
  ],
  "properties": {
    "contract_id": {
      "const": "inventory-run-result-manifest-v1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "source_contract_key": {
      "const": "inventory.run_result_manifest"
    },
    "artifact_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "engine_run_id": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "tenant_id": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
    },
    "project_id": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
    },
    "runtime_request_content_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "canonical_input_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "site_binding_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "strategy_execution_plan_content_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "psi_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "content_hash",
        "artifact_reference"
      ],
      "properties": {
        "snapshot_id": {
          "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
        },
        "content_hash": {
          "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
        },
        "artifact_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      }
    },
    "input_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "input_content_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "projection_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "projection_content_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "profile_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "profile_content_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    },
    "cost_application_mode": {
      "const": "DEVELOPMENT_LANE_PRICING_PROXY"
    },
    "recognition_rule": {
      "const": "AT_ORDER_ACCEPTANCE_INCLUDING_OUT_OF_HORIZON_RECEIPTS"
    },
    "cost_currency": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/currency"
    },
    "operational_cost_eligible": {
      "const": false
    },
    "cost_children": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "psi_child_result_id",
          "item_id",
          "decision_id",
          "decision_date",
          "accepted_order_qty",
          "artifact_reference",
          "content_hash",
          "shipment_content_hash",
          "calculation_status",
          "binding"
        ],
        "properties": {
          "psi_child_result_id": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "decision_id": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
          },
          "decision_date": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/date"
          },
          "accepted_order_qty": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/positiveDecimal"
          },
          "artifact_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "content_hash": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
          },
          "shipment_content_hash": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
          },
          "calculation_status": {
            "enum": [
              "CALCULABLE",
              "NOT_CALCULABLE"
            ]
          },
          "binding": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/binding"
          }
        }
      }
    },
    "simulation_metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 98,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "psi_child_result_id",
          "status",
          "operating_cost",
          "net_landed_cost",
          "total_cost",
          "accepted_order_count",
          "accepted_order_qty",
          "unpriced_orders",
          "reason_code"
        ],
        "properties": {
          "psi_child_result_id": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "NOT_AVAILABLE"
            ]
          },
          "operating_cost": {
            "oneOf": [
              {
                "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "net_landed_cost": {
            "oneOf": [
              {
                "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_cost": {
            "oneOf": [
              {
                "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted_order_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "accepted_order_qty": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
          },
          "unpriced_orders": {
            "type": "array",
            "minItems": 0,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_id",
                "decision_id",
                "decision_date",
                "accepted_order_qty",
                "reason_code"
              ],
              "properties": {
                "item_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "decision_id": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
                },
                "decision_date": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/date"
                },
                "accepted_order_qty": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/positiveDecimal"
                },
                "reason_code": {
                  "const": "PRICING_TEMPLATE_MISSING"
                }
              }
            }
          },
          "reason_code": {
            "oneOf": [
              {
                "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "AVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "operating_cost": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
                },
                "net_landed_cost": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
                },
                "total_cost": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"
                },
                "reason_code": {
                  "type": "null"
                },
                "unpriced_orders": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "operating_cost": {
                  "type": "null"
                },
                "net_landed_cost": {
                  "type": "null"
                },
                "total_cost": {
                  "type": "null"
                },
                "reason_code": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
                }
              }
            }
          }
        ]
      }
    },
    "simulation_comparisons": {
      "type": "array",
      "minItems": 0,
      "maxItems": 97,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "baseline_psi_child_result_id",
          "candidate_psi_child_result_id",
          "status",
          "total_cost_delta",
          "reason_code"
        ],
        "properties": {
          "baseline_psi_child_result_id": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
          },
          "candidate_psi_child_result_id": {
            "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "NOT_AVAILABLE"
            ]
          },
          "total_cost_delta": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason_code": {
            "oneOf": [
              {
                "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "AVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "total_cost_delta": {
                  "type": "string"
                },
                "reason_code": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "total_cost_delta": {
                  "type": "null"
                },
                "reason_code": {
                  "$ref": "landed_cost_shipment_input.schema.json#/$defs/id"
                }
              }
            }
          }
        ]
      }
    },
    "content_hash": {
      "$ref": "landed_cost_shipment_input.schema.json#/$defs/hash"
    }
  }
}
