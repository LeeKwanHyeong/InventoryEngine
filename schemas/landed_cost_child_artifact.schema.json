{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dsio.local/landed_cost_child_artifact.schema.json",
  "title": "Development Landed Cost Child Artifact v1 (not a PSI result child)",
  "type": "object", "additionalProperties": false,
  "required": ["contract_id", "contract_version", "artifact_reference", "binding", "shipment_reference", "shipment_content_hash", "projection_reference", "projection_content_hash", "calculator_binding", "calculation_purpose", "operational_eligible", "automatic_publish_allowed", "automatic_order_allowed", "cost_currency", "row_count", "calculation_status", "rows", "totals", "content_hash"],
  "properties": {
    "contract_id": {"const": "io-landed-cost-child-artifact-v1"}, "contract_version": {"const": "1.0.0"},
    "artifact_reference": {"$ref": "#/$defs/reference"},
    "binding": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/binding"},
    "shipment_reference": {"$ref": "#/$defs/reference"}, "shipment_content_hash": {"$ref": "#/$defs/hash"},
    "projection_reference": {"$ref": "#/$defs/reference"}, "projection_content_hash": {"$ref": "#/$defs/hash"},
    "calculator_binding": {"type": "object", "additionalProperties": false,
      "required": ["contract_key", "contract_version", "implementation_content_hash"], "properties": {
        "contract_key": {"const": "inventory.landed_cost.development-calculator"},
        "contract_version": {"const": "1.0.0"}, "implementation_content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "calculation_purpose": {"const": "DEVELOPMENT_FIXTURE"},
    "operational_eligible": {"const": false}, "automatic_publish_allowed": {"const": false}, "automatic_order_allowed": {"const": false},
    "cost_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "row_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "calculation_status": {"enum": ["CALCULABLE", "NOT_CALCULABLE"]},
    "rows": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "object", "additionalProperties": false,
      "required": ["grain", "assessment", "calculation_status", "blocking_reason_codes"], "properties": {
        "grain": {"$ref": "#/$defs/grain"},
        "assessment": {"oneOf": [{"$ref": "landed_cost_assessment.schema.json"}, {"type": "null"}]},
        "calculation_status": {"enum": ["CALCULABLE", "UNVERIFIED_CLASSIFICATION", "UNVERIFIED_ORIGIN", "UNVERIFIED_TAX_RECOVERABILITY", "MISSING_EXCHANGE_RATE", "NOT_CALCULABLE"]},
        "blocking_reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/id"}}
      },
      "allOf": [{"if": {"properties": {"calculation_status": {"const": "CALCULABLE"}}},
        "then": {"properties": {"assessment": {"$ref": "landed_cost_assessment.schema.json"}, "blocking_reason_codes": {"maxItems": 0}}},
        "else": {"properties": {"assessment": {"type": "null"}, "blocking_reason_codes": {"minItems": 1}}}
      }]
    }},
    "totals": {"type": "object", "additionalProperties": false,
      "required": ["customs_value_amount", "gross_landed_cost_amount", "recoverable_tax_amount", "net_landed_cost_amount"],
      "properties": {
        "customs_value_amount": {"$ref": "#/$defs/nullableDecimal"}, "gross_landed_cost_amount": {"$ref": "#/$defs/nullableDecimal"},
        "recoverable_tax_amount": {"$ref": "#/$defs/nullableDecimal"}, "net_landed_cost_amount": {"$ref": "#/$defs/nullableDecimal"}
      }
    }, "content_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [{
    "if": {"properties": {"calculation_status": {"const": "CALCULABLE"}}},
    "then": {"properties": {
      "rows": {"items": {"properties": {"calculation_status": {"const": "CALCULABLE"}}}},
      "totals": {"properties": {
        "customs_value_amount": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"},
        "gross_landed_cost_amount": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"},
        "recoverable_tax_amount": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"},
        "net_landed_cost_amount": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"}
      }}
    }},
    "else": {"properties": {"totals": {"properties": {
      "customs_value_amount": {"type": "null"}, "gross_landed_cost_amount": {"type": "null"},
      "recoverable_tax_amount": {"type": "null"}, "net_landed_cost_amount": {"type": "null"}
    }}}}
  }],
  "$defs": {
    "reference": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableDecimal": {"oneOf": [{"$ref": "landed_cost_shipment_input.schema.json#/$defs/decimal"}, {"type": "null"}]},
    "grain": {"type": "object", "additionalProperties": false,
      "required": ["shipment_id", "shipment_line_id", "lane_id", "item_id", "valuation_date"], "properties": {
        "shipment_id": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/id"},
        "shipment_line_id": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/id"},
        "lane_id": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/id"},
        "item_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "valuation_date": {"$ref": "landed_cost_shipment_input.schema.json#/$defs/date"}
      }
    }
  }
}
