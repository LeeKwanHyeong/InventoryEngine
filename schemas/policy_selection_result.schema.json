{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsai:inventory-policy-selection-result:1.0.0",
  "title": "Immutable per-item development policy selection result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "status",
    "selection_algorithm",
    "selection_rule",
    "ranking_fields",
    "evaluation_mode",
    "optimality_scope",
    "context",
    "search_result_reference",
    "search_result_content_hash",
    "minimum_fill_rate",
    "terminal_condition",
    "item_selections",
    "selected_item_count",
    "not_selected_item_count",
    "automatic_publish_allowed",
    "automatic_order_allowed",
    "operational_policy_approved",
    "database_writes",
    "canonical_input_hash",
    "prepared_input_hash",
    "mathematical_input_hash",
    "search_config_hash",
    "config_hash",
    "classification_snapshot_id",
    "classification_content_hash",
    "content_hash"
  ],
  "properties": {
    "contract_id": {
      "const": "inventory-policy-selection-result"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "POLICY_SELECTION_COMPUTED_LOCALLY"
    },
    "selection_algorithm": {
      "const": "SERVICE_COST_INVENTORY_ORDER_LEXICOGRAPHIC_V1"
    },
    "selection_rule": {
      "const": "SERVICE_FEASIBLE_THEN_LOWEST_COST"
    },
    "ranking_fields": {
      "const": [
        "total_cost",
        "average_on_hand_eoh_qty",
        "order_count",
        "candidate_id"
      ]
    },
    "evaluation_mode": {
      "const": "DEVELOPMENT_SHADOW"
    },
    "optimality_scope": {
      "const": "EVALUATED_CANDIDATE_SET_ONLY"
    },
    "context": {
      "type": "object"
    },
    "search_result_reference": {
      "type": "string",
      "pattern": "^PSR-[0-9a-f]{64}$"
    },
    "search_result_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_fill_rate": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,6})?|1(\\.0{1,6})?)$"
    },
    "terminal_condition": {
      "const": "FINITE_HORIZON_NO_TERMINAL_VALUE_ARRIVALS_OUTSIDE_HORIZON_REJECTED"
    },
    "item_selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "selected_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "not_selected_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "automatic_publish_allowed": {
      "const": false
    },
    "automatic_order_allowed": {
      "const": false
    },
    "operational_policy_approved": {
      "const": false
    },
    "database_writes": {
      "const": false
    },
    "canonical_input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prepared_input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mathematical_input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "search_config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "classification_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "classification_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "total_cost",
        "currency",
        "average_on_hand_eoh_qty",
        "order_count",
        "current_demand_fill_rate",
        "ending_backorder_qty"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^PC-[0-9a-f]{64}$"
        },
        "total_cost": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 96
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "average_on_hand_eoh_qty": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 96
        },
        "order_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_demand_fill_rate": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
        },
        "ending_backorder_qty": {
          "const": "0"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "segment_key",
        "policy_kind",
        "rmos",
        "emos",
        "target_service_level",
        "review_cycle_weeks",
        "range_source",
        "override_reason",
        "candidate_id"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "segment_key": {
          "enum": [
            "AX",
            "AY",
            "AZ",
            "BX",
            "BY",
            "BZ",
            "CX",
            "CY",
            "CZ"
          ]
        },
        "policy_kind": {
          "enum": [
            "ROP_FIXED_Q",
            "PERIODIC_ORDER_UP_TO"
          ]
        },
        "rmos": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 96
        },
        "emos": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 96
        },
        "target_service_level": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 96
        },
        "review_cycle_weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "range_source": {
          "enum": [
            "GROUP_PROFILE",
            "ITEM_OVERRIDE"
          ]
        },
        "override_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^PC-[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_result_hash",
        "status",
        "rank",
        "reason_codes",
        "failure_reason",
        "score"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^PC-[0-9a-f]{64}$"
        },
        "candidate_result_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "SELECTED",
            "NOT_SELECTED",
            "INELIGIBLE",
            "FAILED"
          ]
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SEARCH_ITEM_EXCLUDED",
              "NO_CANDIDATES_EVALUATED",
              "ALL_CANDIDATES_FAILED",
              "CANDIDATE_FAILED",
              "ORDER_GATE_BLOCKED",
              "RECOMMENDATION_CALCULATION_BLOCKED",
              "NO_DEMAND_IN_HORIZON",
              "FILL_RATE_BELOW_MINIMUM",
              "ENDING_BACKORDER_REMAINS",
              "COST_PROFILE_NOT_BOUND",
              "RANKED_FIRST",
              "HIGHER_TOTAL_COST",
              "HIGHER_AVERAGE_INVENTORY",
              "MORE_ORDERS",
              "CANDIDATE_ID_TIE_BREAK",
              "ONLY_ELIGIBLE_CANDIDATE",
              "LOWEST_TOTAL_COST",
              "TIE_RESOLVED_BY_AVERAGE_INVENTORY",
              "TIE_RESOLVED_BY_ORDER_COUNT",
              "TIE_RESOLVED_BY_CANDIDATE_ID"
            ]
          }
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/score"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SELECTED"
              }
            }
          },
          "then": {
            "properties": {
              "rank": {
                "const": 1
              },
              "score": {
                "$ref": "#/$defs/score"
              },
              "failure_reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_SELECTED"
              }
            }
          },
          "then": {
            "properties": {
              "rank": {
                "type": "integer",
                "minimum": 2
              },
              "score": {
                "$ref": "#/$defs/score"
              },
              "failure_reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "INELIGIBLE",
                  "FAILED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "rank": {
                "const": null
              },
              "score": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "failure_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INELIGIBLE"
              }
            }
          },
          "then": {
            "properties": {
              "failure_reason": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "status",
        "reason_codes",
        "search_exclusion_reason",
        "selected_candidate_id",
        "selected_candidate_result_hash",
        "selected_policy",
        "selected_score",
        "source_review_required",
        "candidate_decisions"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "SELECTED",
            "NOT_SELECTED"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SEARCH_ITEM_EXCLUDED",
              "NO_CANDIDATES_EVALUATED",
              "ALL_CANDIDATES_FAILED",
              "CANDIDATE_FAILED",
              "ORDER_GATE_BLOCKED",
              "RECOMMENDATION_CALCULATION_BLOCKED",
              "NO_DEMAND_IN_HORIZON",
              "FILL_RATE_BELOW_MINIMUM",
              "ENDING_BACKORDER_REMAINS",
              "COST_PROFILE_NOT_BOUND",
              "RANKED_FIRST",
              "HIGHER_TOTAL_COST",
              "HIGHER_AVERAGE_INVENTORY",
              "MORE_ORDERS",
              "CANDIDATE_ID_TIE_BREAK",
              "ONLY_ELIGIBLE_CANDIDATE",
              "LOWEST_TOTAL_COST",
              "TIE_RESOLVED_BY_AVERAGE_INVENTORY",
              "TIE_RESOLVED_BY_ORDER_COUNT",
              "TIE_RESOLVED_BY_CANDIDATE_ID"
            ]
          }
        },
        "search_exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^PC-[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_candidate_result_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_score": {
          "anyOf": [
            {
              "$ref": "#/$defs/score"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_review_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "candidate_decisions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SELECTED"
              }
            }
          },
          "then": {
            "properties": {
              "selected_candidate_id": {
                "type": "string",
                "pattern": "^PC-[0-9a-f]{64}$"
              },
              "selected_candidate_result_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "selected_policy": {
                "$ref": "#/$defs/candidate"
              },
              "selected_score": {
                "$ref": "#/$defs/score"
              },
              "source_review_required": {
                "type": "boolean"
              },
              "search_exclusion_reason": {
                "const": null
              },
              "candidate_decisions": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "selected_candidate_id": {
                "const": null
              },
              "selected_candidate_result_hash": {
                "const": null
              },
              "selected_policy": {
                "const": null
              },
              "selected_score": {
                "const": null
              },
              "source_review_required": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
