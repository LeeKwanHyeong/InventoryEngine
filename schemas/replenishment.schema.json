{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsio:replenishment:v1",
  "title": "Local replenishment execution configuration or strategy proposal",
  "oneOf": [
    {
      "$ref": "#/$defs/execution"
    },
    {
      "$ref": "#/$defs/proposal"
    },
    {
      "$ref": "#/$defs/executionV1_1"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qty": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "version",
        "content_hash"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy_type",
        "implementation_id",
        "version",
        "model"
      ],
      "properties": {
        "strategy_type": {
          "enum": [
            "MATHEMATICAL",
            "PREDICTIVE_ML",
            "DEEP_RL"
          ]
        },
        "implementation_id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/model"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "strategy_type": {
            "const": "MATHEMATICAL"
          }
        }
      },
      "then": {
        "properties": {
          "model": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "model": {
            "$ref": "#/$defs/model"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "uom",
        "max_order_qty",
        "min_target_qty",
        "max_target_qty",
        "order_dates"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/id"
        },
        "uom": {
          "$ref": "#/$defs/id"
        },
        "max_order_qty": {
          "$ref": "#/$defs/qty"
        },
        "min_target_qty": {
          "$ref": "#/$defs/qty"
        },
        "max_target_qty": {
          "$ref": "#/$defs/qty"
        },
        "order_dates": {
          "type": "array",
          "maxItems": 520,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "psi_scenario_type",
        "execution_mode",
        "configuration_revision",
        "canonical_input_hash",
        "strategy",
        "approval_reference",
        "allowed_action_types",
        "decision_timing",
        "receipt_mapping",
        "capacity_mode",
        "item_controls"
      ],
      "properties": {
        "contract_id": {
          "const": "io-replenishment-v1"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "psi_scenario_type": {
          "const": "RECOMMENDED"
        },
        "execution_mode": {
          "const": "LOCAL_SHADOW"
        },
        "configuration_revision": {
          "$ref": "#/$defs/id"
        },
        "canonical_input_hash": {
          "$ref": "#/$defs/hash"
        },
        "strategy": {
          "$ref": "#/$defs/strategy"
        },
        "approval_reference": {
          "$ref": "#/$defs/id"
        },
        "allowed_action_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "contains": {
            "const": "HOLD"
          },
          "items": {
            "enum": [
              "HOLD",
              "ORDER_QTY",
              "ORDER_UP_TO"
            ]
          }
        },
        "decision_timing": {
          "const": "BUCKET_START_BEFORE_RECEIPTS"
        },
        "receipt_mapping": {
          "const": "NEXT_BUCKET_START_ON_OR_AFTER_DUE_DATE"
        },
        "capacity_mode": {
          "const": "CONSERVATIVE_NO_DEMAND_CREDIT"
        },
        "item_controls": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/control"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safety_stock_qty",
        "rop_qty",
        "target_inventory_qty"
      ],
      "properties": {
        "safety_stock_qty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/qty"
            }
          ]
        },
        "rop_qty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/qty"
            }
          ]
        },
        "target_inventory_qty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/qty"
            }
          ]
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "decision_id",
        "observation_hash",
        "strategy",
        "action_type",
        "quantity",
        "calculated_policy",
        "reason_codes"
      ],
      "properties": {
        "contract_id": {
          "const": "io-replenishment-decision-v1"
        },
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "observation_hash": {
          "$ref": "#/$defs/hash"
        },
        "strategy": {
          "$ref": "#/$defs/strategy"
        },
        "action_type": {
          "enum": [
            "HOLD",
            "ORDER_QTY",
            "ORDER_UP_TO"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/qty"
        },
        "calculated_policy": {
          "$ref": "#/$defs/policy"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "strategyInputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "snapshot_id",
        "content_hash"
      ],
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "$ref": "#/$defs/id"
        },
        "snapshot_id": {
          "$ref": "#/$defs/id"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "executionV1_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "psi_scenario_type",
        "execution_mode",
        "configuration_revision",
        "canonical_input_hash",
        "strategy",
        "approval_reference",
        "allowed_action_types",
        "decision_timing",
        "receipt_mapping",
        "capacity_mode",
        "item_controls",
        "strategy_input_binding"
      ],
      "properties": {
        "contract_id": {
          "const": "io-replenishment-v1"
        },
        "contract_version": {
          "const": "1.1.0"
        },
        "psi_scenario_type": {
          "const": "RECOMMENDED"
        },
        "execution_mode": {
          "const": "LOCAL_SHADOW"
        },
        "configuration_revision": {
          "$ref": "#/$defs/id"
        },
        "canonical_input_hash": {
          "$ref": "#/$defs/hash"
        },
        "strategy": {
          "$ref": "#/$defs/strategy"
        },
        "approval_reference": {
          "$ref": "#/$defs/id"
        },
        "allowed_action_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "contains": {
            "const": "HOLD"
          },
          "items": {
            "enum": [
              "HOLD",
              "ORDER_QTY",
              "ORDER_UP_TO"
            ]
          }
        },
        "decision_timing": {
          "const": "BUCKET_START_BEFORE_RECEIPTS"
        },
        "receipt_mapping": {
          "const": "NEXT_BUCKET_START_ON_OR_AFTER_DUE_DATE"
        },
        "capacity_mode": {
          "const": "CONSERVATIVE_NO_DEMAND_CREDIT"
        },
        "item_controls": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "strategy_input_binding": {
          "$ref": "#/$defs/strategyInputBinding"
        }
      }
    }
  }
}
