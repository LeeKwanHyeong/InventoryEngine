          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "training_profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "normalizer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mean",
            "std"
          ],
          "properties": {
            "mean": {
              "type": "array",
              "minItems": 14,
              "maxItems": 14,
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              }
            },
            "std": {
              "type": "array",
              "minItems": 14,
              "maxItems": 14,
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              }
            }
          }
        },
        "policy_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lookback_weeks",
            "stddev_ddof",
            "replenishment_cycle_weeks"
          ],
          "properties": {
            "lookback_weeks": {
              "enum": [
                13,
                26
              ]
            },
            "stddev_ddof": {
              "const": 1
            },
            "replenishment_cycle_weeks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52
            }
          }
        },
        "strategy_type": {
          "const": "PREDICTIVE_ML"
        },
        "algorithm": {
          "const": "positive-error-quantile-linear-v1"
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "linear.weight",
            "linear.bias"
          ],
          "properties": {
            "linear.weight": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                }
              }
            },
            "linear.bias": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              }
            }
          }
        }
      }
