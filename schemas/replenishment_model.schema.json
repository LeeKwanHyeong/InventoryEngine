{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsio:replenishment-model:v1",
  "description": "JSON weights only. DTO additionally validates finite/ranged decimal coefficients, std >= 1e-6, content hash, scope, policy profile and temporal availability.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_version",
        "model_id",
        "version",
        "content_hash",
        "feature_contract_id",
        "scope",
        "training_data_hash",
        "trained_through_date",
        "training_run_id",
        "training_profile_hash",
        "runtime_version",
        "normalizer",
        "policy_contract",
        "strategy_type",
        "algorithm",
        "weights"
      ],
      "properties": {
        "contract_id": {
          "const": "io-replenishment-model-v1"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "feature_contract_id": {
          "const": "io-learned-observation-v1"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "company_cd",
            "subs_cd",
            "site_cd",
            "configuration_revision",
            "plan_type"
          ],
          "properties": {
            "company_cd": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
